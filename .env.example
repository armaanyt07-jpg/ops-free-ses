# ---------------------------------------------------------------------------
# Ops-Free SES Engine — Phase 1 environment
#
# TEMPLATE ONLY — every value here is a placeholder.
# Copy to `.env.local` and fill that in instead; `.env.local` is gitignored.
# This file is committed, so a real secret placed here would be published.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API.
# Both of these are safe to expose to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# PostgreSQL — Supabase → Connect → ORMs / "Transaction pooler" (port 6543).
# Server-side only. Must never reach the browser.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres

# Upstash Redis — the BullMQ queue backend.
#
# MUST be the Redis protocol URL (rediss://), NOT the REST URL (https://).
# BullMQ ships Lua scripts and uses blocking reads; the REST API supports
# neither. Upstash console → your database → "Redis" / ioredis tab.
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Worker tuning (optional).
# WORKER_CONCURRENCY is jobs in flight per worker process; default 5.
# The SES rate limit is enforced separately and per tenant, so raising this
# does not risk exceeding a customer's provider quota.
WORKER_CONCURRENCY=5
# WORKER_ID=w-local

# Master key for AES-256-GCM encryption of stored AWS secret access keys.
# Must decode to exactly 32 bytes. Generate with:
#
#   openssl rand -base64 32
#
# Rotating this key makes every stored AWS credential undecryptable; they must
# be re-entered. Back it up separately from the database.
ENCRYPTION_KEY=<openssl rand -base64 32>

# --- Phase 7 (all optional) -------------------------------------------------

# Master-key rotation: set to the OLD key while ENCRYPTION_KEY holds the new
# one, run `npm run rotate:encryption-key`, then remove this.
# ENCRYPTION_KEY_PREVIOUS=<old key, during rotation only>

# API abuse protection (defaults shown). Per client IP applies to every public
# API route before any database work; per key applies to POST /api/v1/send.
# RATE_LIMIT_IP_PER_SECOND=20
# RATE_LIMIT_IP_BURST=40
# RATE_LIMIT_KEY_PER_SECOND=50
# RATE_LIMIT_KEY_BURST=100

# Bot protection on sign-up, sign-in and password reset (Cloudflare Turnstile).
# The SITE key is public by design. Leave unset to keep the check off.
# Set it (plain "Config" type in Vercel, not "Secret"), redeploy, and only THEN
# enable CAPTCHA in Supabase (Auth -> Bot and Abuse Protection) with the SECRET
# key, which goes only into the Supabase dashboard, never into any file here.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile site key>

# Error monitoring (docs/operations/OBSERVABILITY.md). Off when unset.
# The DSN is public by design: it can submit events, never read them.
# App (inlined at build time):
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.<region>.sentry.io/<project>
# Worker:
# SENTRY_DSN=https://<key>@<org>.ingest.<region>.sentry.io/<project>

# --- End-to-end tests (npm run test:e2e), all optional ----------------------
# See tests/e2e/README.md. Without these, only the specs that don't need a
# signed-in account run; the rest skip cleanly.

# A real, already-confirmed account in THIS project's Supabase instance.
# The suite signs in as this user; it never signs one up itself.
# E2E_EMAIL=you+e2e@example.com
# E2E_PASSWORD=<its password>

# A real AWS credential (SES sandbox is enough) used only to prove the send
# pipeline via SES's mailbox simulator address. Needs ses:GetAccount and
# ses:SendEmail. Omit to skip the one spec that sends a real message.
# E2E_AWS_ACCESS_KEY_ID=
# E2E_AWS_SECRET_ACCESS_KEY=
# E2E_AWS_REGION=us-east-1
# E2E_FROM_ADDRESS=you@a-verified-identity.example.com

# --- Phase 8 (optional) -----------------------------------------------------

# Public base URL of this app, used as the SNS webhook endpoint by "Connect
# events". Unset: derived from the request's Host header. Set it when that
# host isn't what AWS should call (e.g. a tunnel during development).
# PUBLIC_APP_URL=https://<your-app-domain>
