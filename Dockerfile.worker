# Delivery + domain-verification worker — SRS §15: "long-lived BullMQ workers
# should not be treated as ordinary Vercel serverless request handlers".
# Runs on any container host (Railway, Fly.io, Render, ECS). The Next.js app
# deploys to Vercel separately. See docs/operations/DEPLOYMENT.md.
#
# NOTE: written but not built in development (no Docker on the build machine).
# Build and run it once in staging before relying on it.

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

# Dependencies first, for layer caching. Dev dependencies are needed: the
# worker runs TypeScript directly through tsx.
COPY package.json package-lock.json ./
RUN npm ci --include=dev && npm cache clean --force

COPY tsconfig.json tsconfig.worker.json ./
COPY src ./src
COPY worker ./worker

# Never run as root.
USER node

# SIGTERM → graceful drain (worker/index.ts): in-flight jobs finish, anything
# still running after the platform's grace period is recovered by stalled-job
# detection. Configure a grace period of at least 60s (the job lock duration).
STOPSIGNAL SIGTERM
CMD ["npx", "tsx", "--tsconfig", "tsconfig.worker.json", "worker/index.ts"]
