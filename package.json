{
  "name": "ops-ses-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx --tsconfig tsconfig.worker.json worker/index.ts",
    "worker:dev": "tsx watch --tsconfig tsconfig.worker.json worker/index.ts",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "rotate:encryption-key": "tsx --tsconfig tsconfig.worker.json scripts/rotate-encryption-key.ts",
    "reconcile": "tsx --tsconfig tsconfig.worker.json scripts/reconcile.ts",
    "test:resilience": "RESILIENCE=1 vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "load-test": "tsx --tsconfig tsconfig.worker.json scripts/load-test.ts",
    "preflight": "tsx --tsconfig tsconfig.worker.json scripts/preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-route-53": "^3.1143.0",
    "@aws-sdk/client-sesv2": "^3.1141.0",
    "@aws-sdk/client-sns": "^3.1143.0",
    "@sentry/core": "11.2.0",
    "@sentry/nextjs": "11.2.0",
    "@sentry/node": "11.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "bullmq": "^6.3.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true
  }
}
