{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"],
      /*
       * The worker is a standalone Node process, not a Next.js bundle, so the
       * `server-only` guard would throw on import. It is mapped to an empty
       * module here and here only — the Next.js build still enforces it.
       */
      "server-only": ["./worker/server-only-shim.ts"]
    }
  },
  "include": ["worker/**/*.ts", "src/**/*.ts", "src/**/*.tsx"]
}
